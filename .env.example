# Taskrix example environment configuration
# Copy to .env (do not commit real secrets) and fill values.

# Required
MATRIX_HS=https://matrix.example.com
MATRIX_USER=@taskrix:example.com
MATRIX_PASS=your_password_here

# Required: path to your Obsidian vault
VAULT=/path/to/obsidian/vault

# Language: en (default) or fa
LANG=en

# Task routing: inbox (default) or journal
TASK_DEST=inbox
INBOX_FILE=Inbox.md
JOURNAL_DIR=journals
# Optional heading inserted into new journal files
# TASKS_HEADING=## Tasks

# Optional: limit which folders are scanned for tasks (comma-separated, relative to VAULT)
# INCLUDE_DIRS=journals,projects
# Optional: folders to ignore when scanning (comma-separated names). Default excludes .obsidian,.trash,.git,templates
# IGNORE_DIRS=.obsidian,.trash,.git,templates

# Storage for Matrix sync state
STORE=./taskrix-store

# Optional: daily digest
# REMIND_ROOM=!roomid:example.com
DIGEST_AT=08:00

# Optional: allowed senders (comma-separated MXIDs). Default is MATRIX_USER only.
# ALLOWED=@you:example.com,@other:example.com

# Optional: admin user for bot commands like !config show (default: MATRIX_USER)
# ADMIN_USER=@you:example.com

# Logging
RUST_LOG=info